# Plain environment file, mode 0600, readable only by the service user (design §17.4, D4: no secret manager).
HK_AUTH=google
HK_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
HK_ALLOWED_EMAILS=you@gmail.com,partner@gmail.com
HK_SESSION_SECRET=change-me-64-hex-chars
HK_DATA_DIR=/var/lib/hearthkeeper
PORT=8080
